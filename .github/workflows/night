name: Evening BTTS Tipps 🌙

on:
  schedule:
    - cron: '0 15 * * *'   # 15:00 UTC = 17:00 CH Sommer / 16:00 CH Winter
  workflow_dispatch:

jobs:
  run-bot-evening:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install requests python-dotenv

      - name: Run Evening Bot 🌙
        env:
          GEMINI_API_KEYS: ${{ secrets.GEMINI_API_KEYS }}
          GROQ_API_KEYS: ${{ secrets.GROQ_API_KEYS }}
          ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}
          FOOTBALL_DATA_API_KEYS: ${{ secrets.FOOTBALL_DATA_API_KEYS }}    # ✅ PLURAL!
          API_FOOTBALL_KEYS: ${{ secrets.API_FOOTBALL_KEYS }}              # ✅ PLURAL!
          SPORTMONKS_API_KEY: ${{ secrets.SPORTMONKS_API_KEY }}
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          TELEGRAM_GROUP_BTTS: ${{ secrets.TELEGRAM_GROUP_BTTS }}
          TELEGRAM_GROUP_OVER25: ${{ secrets.TELEGRAM_GROUP_OVER25 }}
          TELEGRAM_GROUP_COMBO: ${{ secrets.TELEGRAM_GROUP_COMBO }}
          TELEGRAM_GROUP_BTTS_HT: ${{ secrets.TELEGRAM_GROUP_BTTS_HT }}
          TELEGRAM_GROUP_STATS: ${{ secrets.TELEGRAM_GROUP_STATS }}
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
          # 🌙 Amerika + Asien + Ozeanien Ligen (Abendspiele)
          ACTIVE_LEAGUES: "MLS,Brasileirao Serie A,Liga Argentinien,Liga MX,J1 League Japan,K League 1,China Super League,Saudi Pro League,A-League,Iceland Premier League,Iceland 1. Deild"
          AI_SLEEP_SECONDS: "1.5"
        run: python btts_daily.py

      - name: Log Summary
        if: always()
        run: |
          echo "✅ Evening Bot Run Complete"
          echo "Schedule: 15:00 UTC täglich"
          echo "Ligen: MLS, Brasileirao, Liga Argentina, Liga MX"
